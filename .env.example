# Variaveis consumidas pelo docker-compose.yml da raiz.
#
# Este arquivo alimenta APENAS o container do PostgreSQL: sao os tres valores
# que aparecem em ${...} no docker-compose.yml. POSTGRES_DB e POSTGRES_USER tem
# default no compose; POSTGRES_PASSWORD nao tem, entao `docker compose up`
# EXIGE um .env na raiz.
#
# Nao adicione aqui variavel da aplicacao: as do backend ficam em
# back-end/.env.example e as do frontend em front-end/.env.example.
#
# Estes tres valores se repetem em back-end/.env.example de proposito, e nao
# por descuido: aqui eles CRIAM o banco no container; la eles dizem ao
# aplicativo em qual banco CONECTAR. Se mudar de um lado, mude do outro.

POSTGRES_DB=virtual_planner
POSTGRES_USER=virtual_planner

# Obrigatoria e sem valor padrao em lugar nenhum: o docker-compose.yml para com
# erro se ela nao estiver definida, e o scripts/db-migrate.sh aborta.
#
# O valor abaixo e um placeholder que NAO funciona de proposito. A versao
# anterior deste arquivo trazia "change-me", que era uma senha valida: quem
# esquecesse de trocar subia o banco com a credencial publicada neste
# repositorio, e nada avisava.
POSTGRES_PASSWORD=DEFINA-UMA-SENHA
