# Variaveis consumidas pelo docker-compose.yml da raiz.
#
# Este arquivo alimenta APENAS o container do PostgreSQL: sao os tres valores
# que aparecem em ${...} no docker-compose.yml. O compose ja tem defaults
# iguais a estes, entao `docker compose up -d postgres` funciona mesmo sem um
# .env na raiz.
#
# Nao adicione aqui variavel da aplicacao: as do backend ficam em
# back-end/.env.example e as do frontend em front-end/.env.example.
#
# Estes tres valores se repetem em back-end/.env.example de proposito, e nao
# por descuido: aqui eles CRIAM o banco no container; la eles dizem ao
# aplicativo em qual banco CONECTAR. Se mudar de um lado, mude do outro.

POSTGRES_DB=virtual_planner
POSTGRES_USER=virtual_planner
POSTGRES_PASSWORD=change-me
