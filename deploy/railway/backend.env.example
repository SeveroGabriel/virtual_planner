# Referencia para o editor de variaveis da Railway. NAO executar com source.
# Os nomes dos servicos usados nas referencias sao sensiveis a maiusculas.
VP_APP_NAME=virtual-planner
VP_PROFILE=production
VP_LOG_LEVEL=info
VP_USE_POSTGRES=true
VP_HTTP_HOST=0.0.0.0
PORT=8080
# Nao definir VP_HTTP_PORT: ele tem precedencia sobre PORT.
VP_HTTP_ALLOWED_ORIGINS=https://${{frontend.RAILWAY_PUBLIC_DOMAIN}}
POSTGRES_HOST=${{Postgres.PGHOST}}
POSTGRES_PORT=${{Postgres.PGPORT}}
POSTGRES_DB=${{Postgres.PGDATABASE}}
POSTGRES_USER=${{Postgres.PGUSER}}
POSTGRES_PASSWORD=${{Postgres.PGPASSWORD}}
# Para o template oficial PostgreSQL com TLS. Confira o servico real.
POSTGRES_SSLMODE=require
POSTGRES_CONNECT_TIMEOUT=5
POSTGRES_APPLICATION_NAME=virtual-planner
