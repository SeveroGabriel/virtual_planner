# Variaveis da aplicacao backend.
#
# Lidas em runtime pelo executavel: as VP_* por EnvironmentConfigLoader e
# ServerConfig, as POSTGRES_* por PostgresConfig::from_environment(). O
# scripts/db-migrate.sh usa as mesmas POSTGRES_*.
#
# POSTGRES_DB, POSTGRES_USER e POSTGRES_PASSWORD tambem aparecem no
# .env.example da raiz. La eles CRIAM o banco no container do compose; aqui
# dizem em qual banco o aplicativo deve CONECTAR. Mudou de um lado, mude do
# outro.
#
# As variaveis do frontend ficam em front-end/.env.example.

VP_APP_NAME=virtual-planner
VP_PROFILE=development
VP_USE_POSTGRES=true

# Servidor HTTP. Use 0.0.0.0 para responder de fora do container e 127.0.0.1
# para expor apenas a propria maquina. A porta 0 pede uma porta efemera ao
# sistema operacional.
#
# A API usa sessao. Este exemplo HTTP e local: mantenha 127.0.0.1 fora do
# container. Publicacao exige HTTPS; veja docs/railway.md.
VP_HTTP_HOST=127.0.0.1
# Precedencia: VP_HTTP_PORT nao vazio > PORT nao vazio > 8080.
# Na Railway, deixe VP_HTTP_PORT ausente para respeitar PORT.
VP_HTTP_PORT=8080

# Origens autorizadas a chamar a API pelo navegador, separadas por virgula.
# O padrao e o servidor de dev do Vite. Em producao use a origem HTTPS exata
# do frontend, nunca "*". O proxy /api mantem a sessao na mesma origem.
VP_HTTP_ALLOWED_ORIGINS=http://localhost:5173

# Nivel minimo de log: debug, info, warning ou error. Padrao: info.
# Um valor invalido cai em info em vez de impedir a aplicacao de subir.
VP_LOG_LEVEL=info

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=virtual_planner
POSTGRES_USER=virtual_planner
POSTGRES_PASSWORD=DEFINA-UMA-SENHA
# Em VP_PROFILE=production a aplicacao recusa 'disable' e recusa senha
# conhecida: prefira 'require' ou superior.
POSTGRES_SSLMODE=disable
POSTGRES_CONNECT_TIMEOUT=5
POSTGRES_APPLICATION_NAME=virtual-planner
